# GitHub Repository Interconnect — Environment Variables
# Copy this file to .env and fill in your values.

# GitHub Personal Access Token (optional but highly recommended)
# Without a token, you are limited to 60 API requests/hour.
# Create one at: https://github.com/settings/tokens
# Required scopes: public_repo (or none for public repos only)
GITHUB_TOKEN=

# Backend server settings
HOST=127.0.0.1
PORT=8000

# LM Studio base URL (optional — required only for AI features)
# Start LM Studio, load a model, and enable the local server (default port 1234).
LM_STUDIO_URL=http://localhost:1234

